# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
API_PORT=8000

# --- Database ---
# Local run without Docker uses SQLite:
DATABASE_URL=sqlite:///./data.db
# Docker Compose builds the MySQL URL from these:
MYSQL_DATABASE=support_agent
MYSQL_USER=support_user
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- WhatsApp Business Cloud API (developers.facebook.com) ---
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0

# --- AI provider: mock (free, offline) | anthropic | openai ---
LLM_PROVIDER=mock
LLM_API_KEY=your-llm-api-key
LLM_MODEL=

# --- HubSpot CRM (optional, leave empty to disable) ---
HUBSPOT_TOKEN=

# --- Business ---
BUSINESS_NAME=Demo Business
KNOWLEDGE_DIR=knowledge

# --- Admin API (send as X-API-Key header) ---
ADMIN_API_KEY=change-me-long-random-admin-key
